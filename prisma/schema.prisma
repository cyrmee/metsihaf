datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum HighlightColor {
  yellow
  red
  orange
  brown
  green
  teal
  blue
  purple
  pink
}

enum AccentTheme {
  red
  orange
  yellow
  green
  teal
  blue
  purple
  pink
  brown
}

enum LineSpacing {
  tight
  normal
  relaxed
}

enum LetterSpacing {
  tight
  normal
  wide
}

enum VerseViewMode {
  line
  paragraph
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  authUid   String   @unique
  createdAt DateTime @default(now())

  bookmarks   Bookmark[]
  highlights  Highlight[]
  notes       Note[]
  readingPos  ReadingPosition?
  preferences Preference?
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  ref       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ref])
}

model Highlight {
  id     String         @id @default(uuid())
  userId String
  ref    String
  color  HighlightColor
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ref])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  ref       String
  text      String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ref])
}

model ReadingPosition {
  id          String   @id @default(uuid())
  userId      String   @unique
  book        String
  chapter     Int
  translation String
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verse {
  version  String
  language String
  book     String
  chapter  Int
  verse    Int
  verseEnd Int
  label    String
  text     String
  /// Character ranges in `text` spoken by Jesus, e.g. [[0, 42]] — null when the source has no such markup.
  redLetter Json?
  /// Translator footnotes anchored to a character offset in `text`, e.g. [{"at": 30, "note": "Or 'and he saw'"}] — null when the source has none.
  footnotes Json?
  /// Section heading displayed just above this verse, e.g. "Giving to the Needy" for Matthew 6:1 — null except on the verse a section starts at.
  heading String?
  /// Secondary heading below `heading` (e.g. a speaker label in Song of Solomon) — null unless the source has one alongside `heading`.
  subheading String?

  @@id([version, book, chapter, verse])
  @@index([language, version])
}

model Preference {
  id                String        @id @default(uuid())
  userId            String        @unique
  darkMode          Boolean       @default(false)
  fontSize          Int           @default(18)
  verseView         VerseViewMode @default(line)
  accentTheme       AccentTheme   @default(red)
  lineSpacing       LineSpacing   @default(normal)
  letterSpacing     LetterSpacing @default(normal)
  showVerseSelector Boolean       @default(false)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}
