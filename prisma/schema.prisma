datasource db {
  provider   = "postgresql"
  extensions = [btree_gin(version: "1.3"), pg_stat_statements(schema: "extensions", version: "1.11"), pgcrypto(schema: "extensions", version: "1.3"), supabase_vault(schema: "vault", version: "0.3.1"), uuid_ossp(map: "uuid-ossp", schema: "extensions", version: "1.1")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum HighlightColor {
  yellow
  red
  orange
  brown
  green
  teal
  blue
  purple
  pink
}

enum AccentTheme {
  red
  orange
  yellow
  green
  teal
  blue
  purple
  pink
  brown
}

enum LineSpacing {
  tight
  normal
  relaxed
}

enum LetterSpacing {
  tight
  normal
  wide
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  authUid   String   @unique
  createdAt DateTime @default(now())

  bookmarks   Bookmark[]
  highlights  Highlight[]
  notes       Note[]
  readingPos  ReadingPosition?
  preferences Preference?
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  ref       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ref])
}

model Highlight {
  id        String         @id @default(uuid())
  userId    String
  ref       String
  color     HighlightColor
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ref])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  ref       String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ref])
}

model ReadingPosition {
  id          String   @id @default(uuid())
  userId      String   @unique
  book        String
  chapter     Int
  translation String
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verse {
  version    String
  language   String
  book       String
  chapter    Int
  verse      Int
  verseEnd   Int
  label      String
  text       String
  /// Character ranges in `text` spoken by Jesus, e.g. [[0, 42]] — null when the source has no such markup.
  redLetter  Json?
  /// Translator footnotes anchored to a character offset in `text`, e.g. [{"at": 30, "note": "Or 'and he saw'"}] — null when the source has none.
  footnotes  Json?
  /// Section heading displayed just above this verse, e.g. "Giving to the Needy" for Matthew 6:1 — null except on the verse a section starts at.
  heading    String?
  /// Secondary heading below `heading` (e.g. a speaker label in Song of Solomon) — null unless the source has one alongside `heading`.
  subheading String?
  /// Whether this verse is rendered one verse per line (poetry) instead of folded into a flowing paragraph (prose) — from the source's own \q/\p paragraph markup.
  poetic     Boolean @default(false)
  // Full-text search index, managed outside Prisma's schema (expression indexes
  // aren't representable in the Prisma schema language):
  //   CREATE INDEX verse_version_fts_idx ON "Verse"
  //     USING gin (version, to_tsvector('simple', text));
  // Composite on (version, tsvector) rather than tsvector alone: search always
  // filters by version, and GIN can't apply a plain btree "version = " condition
  // as an index cond, so a text-only index made Postgres recheck every matching
  // row from every version on the heap (~120ms for a ~2-version, 62k-row table,
  // and it would only get worse as more translations are seeded). The btree_gin
  // extension lets version ride in the same GIN index, cutting that recheck to
  // near zero (<1ms).

  @@id([version, book, chapter, verse])
  @@index([language, version])
}

model StudyNote {
  /// Commentary this note comes from, e.g. "matthew-henry" — leaves room for more commentaries later.
  source   String
  book     String
  chapter  Int
  /// Anchor verse — the first verse of the passage this note covers.
  verse    Int
  /// Last verse of the passage this note covers (same as `verse` for a single-verse note).
  verseEnd Int
  text     String

  @@id([source, book, chapter, verse])
  @@index([book, chapter])
}

model Preference {
  id                String        @id @default(uuid())
  userId            String        @unique
  darkMode          Boolean       @default(false)
  fontSize          Int           @default(18)
  accentTheme       AccentTheme   @default(red)
  lineSpacing       LineSpacing   @default(normal)
  letterSpacing     LetterSpacing @default(normal)
  showVerseSelector Boolean       @default(false)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}
